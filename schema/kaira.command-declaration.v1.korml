version: korml.schema/v1
name: kaira.command-declaration/v1

types:
  identifier:
    kind: scalar
    value: string
    pattern: "[A-Za-z][A-Za-z0-9_-]*"

  command-key:
    kind: scalar
    value: string
    pattern: "[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)*"

  short-identifier:
    kind: scalar
    value: string
    pattern: "[A-Za-z0-9]"

  value-type:
    kind: enum
    values:
      - int
      - float
      - string
      - boolean

  value-style:
    kind: enum
    values:
      - spaced
      - attached

  multiplicity:
    kind: enum
    values:
      - single
      - multiple

  shape:
    kind: enum
    values:
      - none
      - subcommands
      - positionals

  alignment:
    kind: enum
    values:
      - left
      - center
      - right

  count-limit:
    kind: union
    variants:
      integer:
        scalar:
          value: integer
      unbounded:
        scalar:
          value: literal
          literal: unbounded

  flag:
    kind: mapping
    optional:
      short: short-identifier
      help: string

  option:
    kind: mapping
    required:
      value: value-type
      style: value-style
    optional:
      short: short-identifier
      multiplicity: multiplicity
      separator: string
      help: string

  cardinality:
    kind: mapping
    optional:
      min: integer
      max: count-limit

  positional:
    kind: mapping
    required:
      alignment: alignment
      value: value-type
    optional:
      multiplicity: multiplicity
      required: boolean
      cardinality: cardinality
      help: string

  positional-entry:
    kind: mapping-of
    key: identifier
    value: positional

  command:
    kind: mapping
    required:
      shape: shape
    optional:
      help: string
      flags:
        mapping-of:
          key: identifier
          value: flag
      options:
        mapping-of:
          key: identifier
          value: option
      subcommands:
        list-of: command-key
      positionals:
        list-of: positional-entry

root:
  kind: mapping
  required:
    version: string
    program: identifier
    commands:
      mapping-of:
        key: command-key
        value: command
