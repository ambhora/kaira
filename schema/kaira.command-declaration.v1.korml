version: korml.schema/v1
name: kaira.command-declaration/v1

types:
  identifier:
    kind: scalar
    value: string
    pattern: "[A-Za-z][A-Za-z0-9_-]*"

  short-identifier:
    kind: scalar
    value: string
    pattern: "[A-Za-z0-9]"

  value-type:
    kind: enum
    values:
      - int
      - float
      - string
      - boolean

  value-style:
    kind: enum
    values:
      - spaced
      - attached

  count-limit:
    kind: union
    variants:
      integer:
        scalar:
          value: integer
      unbounded:
        scalar:
          value: literal
          literal: unbounded

  option:
    kind: union
    variants:
      flag:
        mapping:
          optional:
            short: short-identifier
            help: string

      scalar:
        mapping:
          required:
            value: value-type
            value_style: value-style
          optional:
            short: short-identifier
            help: string

      repeatable:
        mapping:
          required:
            value: value-type
            value_style: value-style
          optional:
            short: short-identifier
            help: string

      separated:
        mapping:
          required:
            value: value-type
            value_style: value-style
            separator: string
          optional:
            short: short-identifier
            help: string

  positional-tail:
    kind: mapping
    required:
      name: identifier
      value: value-type
    optional:
      min: integer
      max: count-limit
      help: string

  command-tail:
    kind: union
    variants:
      empty:
        mapping: {}

      subcommands:
        mapping:
          required:
            commands:
              mapping-of:
                key: identifier
                value: command
          optional:
            required: boolean

      positionals:
        mapping:
          required:
            positionals: positional-tail

  command:
    kind: mapping
    required:
      tail: command-tail
    optional:
      help: string
      options:
        mapping-of:
          key: identifier
          value: option

root:
  kind: mapping
  required:
    version: string
    program: identifier
    command: command
