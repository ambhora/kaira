{
  "format": "kaira.conformance/v1",
  "declarations": {
    "empty": {
      "version": "kaira.command-declaration/v1",
      "program": "app",
      "commands": {
        "__main__": {
          "shape": "none"
        }
      }
    },
    "options": {
      "version": "kaira.command-declaration/v1",
      "program": "app",
      "commands": {
        "__main__": {
          "shape": "positionals",
          "flags": {
            "verbose": {
              "short": "v"
            }
          },
          "options": {
            "output": {
              "short": "o",
              "style": "attached"
            },
            "include": {
              "style": "spaced",
              "multiplicity": "multiple"
            },
            "features": {
              "style": "spaced",
              "multiplicity": "multiple",
              "separator": ";"
            }
          },
          "positionals": [
            {
              "target": {
                "alignment": "center",
                "multiplicity": "multiple",
                "required": false,
                "cardinality": {
                  "max": 3
                }
              }
            }
          ]
        }
      }
    },
    "commands": {
      "version": "kaira.command-declaration/v1",
      "program": "app",
      "commands": {
        "__main__": {
          "shape": "subcommands",
          "flags": {
            "verbose": {
              "short": "v"
            }
          },
          "subcommands": [
            "__main__.build",
            "__main__.test"
          ]
        },
        "__main__.build": {
          "shape": "none",
          "flags": {
            "verbose": {
              "short": "v"
            }
          }
        },
        "__main__.test": {
          "shape": "none"
        }
      }
    },
    "values": {
